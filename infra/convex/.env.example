# Copy to .env and fill in. Never commit .env.
INSTANCE_NAME=taskrx
INSTANCE_NAME_DB=taskrx            # INSTANCE_NAME with '-' replaced by '_'
POSTGRES_PASSWORD=change-me
INSTANCE_SECRET=64-hex-chars       # openssl rand -hex 32
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3220
CONVEX_SITE_ORIGIN=http://127.0.0.1:3221
# Filled in after first start: docker compose exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=
# Host ports. 3210/3211 are taken by the local `npx convex dev` backend.
PORT=3220
SITE_PROXY_PORT=3221
DASHBOARD_PORT=6791
# Clerk JWT issuer for this deployment (same Clerk instance as the Expo publishable key)
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
