# Clerk JWT issuer domain for Convex auth (packages/convex/convex/auth.config.ts
# reads it). Find it in the Clerk Dashboard under Configure -> API Keys.
# It looks like: https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://replace_me.clerk.accounts.dev

# Convex deploy key (used by `npx convex dev` / `npx convex deploy`).
# For the self-hosted backend in infra/convex, see infra/convex/README.md.
CONVEX_DEPLOY_KEY=dev:replace_me

# The Android app does not read this file. It takes CONVEX_URL and
# CLERK_PUBLISHABLE_KEY from apps/android/local.properties. See
# apps/android/README.md.
