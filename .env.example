# Mobile auth (Clerk)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk JWT issuer domain for Convex auth.
# Find this in the Clerk Dashboard under Configure -> JWT Templates / API Keys.
# It looks like: https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://replace_me.clerk.accounts.dev

# Convex deploy key (used by `npx convex dev` / `npx convex deploy`)
CONVEX_DEPLOY_KEY=dev:replace_me

# Optional: Convex URL for the mobile client (set automatically by `npx convex dev`)
EXPO_PUBLIC_CONVEX_URL=https://replace_me.convex.cloud
