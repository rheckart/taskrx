{
  "name": "taskrx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POC monorepo for a combined task + medication reminder app",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "npm run -w apps/mobile dev",
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild-apk": "cd apps/mobile/android && ./gradlew assembleDebug",
    "prepare": "husky",
    "verify:migrations": "node apps/mobile/scripts/verify-reminder-migrations.mjs",
    "verify:harness": "apps/mobile/scripts/verify-harness-guards.sh",
    "verify": "npm run typecheck && npm run lint && npm test && npm run verify:migrations && npm run verify:harness"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "trustedDependencies": [
    "@clerk/shared",
    "browser-tabs-lock",
    "core-js"
  ]
}
